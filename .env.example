APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
APP_NAME=Kairus

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME="Kairus"

CONTACT_TO_ADDRESS=your-email@example.com

# Profili pubblici ufficiali mostrati nel footer. Sono URL pubblici, non
# credenziali; i valori non HTTPS vengono omessi dal rendering.
KAIRUS_LINKEDIN_URL=https://www.linkedin.com/company/kairus-it/
KAIRUS_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61593323495927

# Sistema Comunicazione — Invio di test (vedi config/communication.php):
# di default disabilitato. Quando true, il pulsante "Invio di test"
# nell'admin usa il transport MAIL_MAILER già sopra per inviare UNA
# email reale a un iscritto confermato esplicitamente scelto — mai la
# lista destinatari. Non abilitare senza una decisione deliberata.
COMMUNICATION_REAL_SEND_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
ANTHROPIC_API_KEY=

# Token fine-grained, sola lettura (Contents/Pull requests/Checks/Metadata)
# sul repo indicato — usato solo dal sync GitHub dell'Area Progettazione.
GITHUB_TOKEN=

# Analytics Hygiene (docs/ANALYTICS_HYGIENE.md). Il Measurement ID GA4 non
# e' un segreto (e' pubblico nel sorgente HTML di ogni pagina che lo usa).
# ANALYTICS_ENABLED e' un override esplicito, opzionale: lasciato vuoto,
# Analytics si carica automaticamente solo quando APP_ENV=production —
# locale e testing non caricano mai GA4 di default, senza bisogno di
# alcuna azione qui.
GA4_MEASUREMENT_ID=G-Y1853N6FZP
# ANALYTICS_ENABLED=
ANALYTICS_EXCLUSION_COOKIE_DAYS=730
GITHUB_SYNC_REPO=andrea-bartiromo/quark_blog

# Quando true, /turing mostra l'hub completo e i capitoli (/turing/enigma,
# /turing/ai, /turing/legacy, /turing/computation, /turing/intelligence)
# sono pubblici e indicizzati. Lasciare false finche' lo Speciale non e'
# pronto per il rilascio: /turing mostra una landing "In arrivo" e i
# capitoli reindirizzano a /turing. Vedi config/turing.php.
TURING_CHAPTERS_PUBLIC=false

# Percorso assoluto di una document root pubblica secondaria (es.
# public_html su cPanel) quando e' fisicamente separata da public/assets/img
# dell'applicazione. Lasciare vuoto se coincidono o sono collegate da un
# symlink: la sincronizzazione si disattiva da sola. Vedi config/media.php.
# MEDIA_PUBLIC_ROOT=/home/xkairust/public_html/assets/img

VITE_APP_NAME="${APP_NAME}"