# =================================================================
# Kairus — Configurazione PRODUZIONE
# Copiare in .env sul server e compilare i valori reali solo localmente.
# Non versionare mai .env o segreti reali nel repository.
# =================================================================

APP_NAME="Kairus"
APP_ENV=production
APP_KEY= # generare con: php artisan key:generate
APP_DEBUG=false # MAI true in produzione
APP_URL=https://kairus.it
APP_LOCALE=it
APP_TIMEZONE=Europe/Rome

# Database
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/database/database.sqlite

# Cache & Session (usare redis in produzione se disponibile)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true # richiede HTTPS
SESSION_SAME_SITE=strict

# Mail / SMTP Gmail
# Usare una Google App Password, non la password dell'account Google.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME="Kairus"

# Claude AI (per automazione notizie)
ANTHROPIC_API_KEY=

# Log
LOG_CHANNEL=daily
LOG_LEVEL=error # non debug in produzione

# Sincronizzazione media verso una document root pubblica separata
# (es. cPanel: public/assets/img dell'app e' diversa da public_html/).
# Impostare solo se le due directory sono realmente distinte sul server;
# lasciare vuoto/commentato se public_html e' un symlink verso public/.
# MEDIA_PUBLIC_ROOT=/home/xkairust/public_html/assets/img
