# =================================================================
# Kairus — Configurazione PRODUZIONE
# Copiare in .env sul server e compilare i valori reali solo localmente.
# Non versionare mai .env o segreti reali nel repository.
# =================================================================

APP_NAME="Kairus"
APP_ENV=production
APP_KEY= # generare una sola volta durante il provisioning; deploy.sh non la genera/ruota
APP_DEBUG=false # MAI true in produzione
APP_URL=https://kairus.it
APP_LOCALE=it
APP_TIMEZONE=Europe/Rome

# Database production: MariaDB/MySQL.
# Usare DB_CONNECTION=mariadb solo se il runtime Laravel production e' stato
# configurato e verificato esplicitamente con quel connection name.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Cache & Session (usare redis in produzione se disponibile)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true # richiede HTTPS
SESSION_SAME_SITE=strict

# Mail / SMTP Gmail
# Usare una Google App Password, non la password dell'account Google.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME="Kairus"

# Profili pubblici ufficiali mostrati nel footer. Non sono credenziali;
# il rendering accetta esclusivamente URL HTTPS validi.
KAIRUS_LINKEDIN_URL="https://www.linkedin.com/company/kairus-it/"
KAIRUS_FACEBOOK_URL="https://www.facebook.com/profile.php?id=61593323495927"

# Claude AI (per automazione notizie)
ANTHROPIC_API_KEY=

# Log
LOG_CHANNEL=daily
LOG_LEVEL=error # non debug in produzione

# Sincronizzazione media verso una document root pubblica separata
# (es. cPanel: public/assets/img dell'app e' diversa da public_html/).
# Impostare solo se le due directory sono realmente distinte sul server;
# lasciare vuoto/commentato se public_html e' un symlink verso public/.
# MEDIA_PUBLIC_ROOT=/home/xkairust/public_html/assets/img

# Gate di drift degli asset statici di release (CSS/JS/icone — vedi
# docs/DEPLOYMENT.md, sezione "Public asset drift detection and release
# gate"). Stessa distinzione fisica di MEDIA_PUBLIC_ROOT sopra, ma per i
# file gestiti dalla release Git, non dalla Libreria media. Disattivato
# (nessun controllo, deploy.sh non blocca mai) se non impostata.
# DEPLOY_SERVED_PUBLIC_ROOT=/home/xkairust/public_html

# Registro rilasci append-only (Release Registry — vedi docs/DEPLOYMENT.md,
# sezione "Release registry"). REVISION/DEPLOY_INFO vivono dentro la
# directory di release e vengono scartati al deploy successivo: un
# percorso qui, FUORI da ~/kairus_app, conserva la storia dei rilasci tra
# un deploy e l'altro. Mai bloccante (deploy.sh non fallisce mai per
# questo) e disattivato del tutto se non impostata.
# DEPLOY_RELEASE_REGISTRY_PATH=/home/xkairust/kairus_release_registry.jsonl

# Directory dei backup MariaDB/MySQL (Backup V2 — vedi docs/STORAGE_AUDIT.md
# e app/Services/Backup/MariaDbBackupService.php). Default:
# storage_path('backups/mariadb'), DENTRO la directory di release corrente
# — con lo schema a directory separate + switch di symlink, ogni backup
# verrebbe perduto al deploy successivo se questa variabile non punta
# esplicitamente FUORI da ~/kairus_app (Cantiere 18, programma Kairus 100
# cantieri — vedi php artisan deploy:verify-persistent-storage, solo
# informativo: deploy.sh non blocca mai il rilascio per questo).
# DB_BACKUP_DIRECTORY=/home/xkairust/kairus_backups/mariadb

# Soglia di età (in ore) oltre la quale
# `php artisan deploy:verify-database-backup` segnala il backup MariaDB
# (Backup V2) più recente come stantio (Cantiere 19, programma Kairus 100
# cantieri). backup:database-v2 è manuale/opt-in — nessuno scheduler lo
# esegue automaticamente — quindi nessuna cadenza è presunta: come
# DB_BACKUP_RETENTION, deliberatamente opt-in, nessun default indovina una
# policy operativa. Solo informativo: deploy.sh non blocca mai il rilascio
# per questo.
# DB_BACKUP_MAX_AGE_HOURS=168

# Interruttore di emergenza per la pulizia automatica schedulata degli
# iscritti newsletter pendenti scaduti (newsletter:reconfirmation-cleanup,
# giornaliera 04:30 — vedi docs/NEWSLETTER_RECONFIRMATION_CLEANUP_RUNBOOK.md).
# Default true (nessun comportamento esistente cambia se non impostato).
# Impostare esplicitamente a false per sospendere solo questa cancellazione
# automatica, senza toccare l'azione manuale equivalente da /admin/newsletter.
# NEWSLETTER_RECONFIRMATION_CLEANUP_ENABLED=true
