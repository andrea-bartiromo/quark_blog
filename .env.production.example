# =================================================================
# Kairus — Configurazione PRODUZIONE
# Copiare in .env sul server e compilare i valori reali solo localmente.
# Non versionare mai .env o segreti reali nel repository.
# =================================================================

APP_NAME="Kairus"
APP_ENV=production
APP_KEY= # generare una sola volta durante il provisioning; deploy.sh non la genera/ruota
APP_DEBUG=false # MAI true in produzione
APP_URL=https://kairus.it
APP_LOCALE=it
APP_TIMEZONE=Europe/Rome

# Database production: MariaDB/MySQL.
# Usare DB_CONNECTION=mariadb solo se il runtime Laravel production e' stato
# configurato e verificato esplicitamente con quel connection name.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Cache & Session (usare redis in produzione se disponibile)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true # richiede HTTPS
SESSION_SAME_SITE=strict

# Mail / SMTP Gmail
# Usare una Google App Password, non la password dell'account Google.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME="Kairus"

# Profili pubblici ufficiali mostrati nel footer. Non sono credenziali;
# il rendering accetta esclusivamente URL HTTPS validi.
KAIRUS_LINKEDIN_URL="https://www.linkedin.com/company/kairus-it/"
KAIRUS_FACEBOOK_URL="https://www.facebook.com/profile.php?id=61593323495927"

# Claude AI (per automazione notizie)
ANTHROPIC_API_KEY=

# Log
LOG_CHANNEL=daily
LOG_LEVEL=error # non debug in produzione

# Sincronizzazione media verso una document root pubblica separata
# (es. cPanel: public/assets/img dell'app e' diversa da public_html/).
# Impostare solo se le due directory sono realmente distinte sul server;
# lasciare vuoto/commentato se public_html e' un symlink verso public/.
# MEDIA_PUBLIC_ROOT=/home/xkairust/public_html/assets/img

# Radice pubblica REALMENTE servita da Apache (es. cPanel public_html),
# se distinta da public/ dell'app — vedi docs/DEPLOYMENT.md, sezione
# "due document root". Attiva il gate `php artisan deploy:asset-drift`
# (gia' chiamato da deploy.sh): se lasciata vuota/commentata, il gate e'
# un no-op e non blocca mai il deploy. Questo e' l'esatto meccanismo che
# ha chiuso l'incidente reale del 24/08 (public-premium.css disallineato
# tra le due radici) — vedi anche MEDIA_PUBLIC_ROOT sopra, stesso principio,
# meccanismo di sincronizzazione diverso.
# DEPLOY_SERVED_PUBLIC_ROOT=/home/xkairust/public_html

# Backup V2 (php artisan backup:database-v2) — manuale/opt-in, MAI invocato
# da deploy.sh o dallo scheduler. Vedi docs/BACKUP_V2_OPERATIONS.md: la
# produzione deve confermare esplicitamente questi valori prima di
# qualunque abilitazione — nessun default di questo repository sostituisce
# quella conferma.
# DB_BACKUP_BINARY= # vuoto = auto-discover (mariadb-dump, poi mysqldump)
# DB_BACKUP_DIRECTORY=/home/xkairust/backups/mariadb
# DB_BACKUP_RETENTION= # deliberatamente non impostato: nessuna policy assunta
# DB_BACKUP_LOCK_STORE=file # deve essere condiviso da ogni host che puo' lanciare il backup
# DB_BACKUP_LOCK_SECONDS=900
