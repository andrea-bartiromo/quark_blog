<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Forza HTTPS: kairus.it deve avere un solo host canonico. Prima regola
    # del file cosi' una richiesta http:// viene reindirizzata prima di
    # qualunque altra riscrittura, preservando path e query string (nessun
    # "?" nella sostituzione: mod_rewrite ricopia automaticamente la query
    # string originale). %{HTTPS} riflette la connessione reale terminata
    # da Apache (cPanel/AutoSSL, nessun reverse proxy davanti): nessun
    # rischio di loop in questo setup. Se in futuro venisse introdotto un
    # proxy/CDN che termina TLS a monte, questa condizione andra' sostituita
    # con un controllo su X-Forwarded-Proto.
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Blocca accesso a file .env e altri sensibili
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^bootstrap/cache/ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Protezione aggiuntiva file sensibili
<FilesMatch "\.(env|log|sqlite|sh|bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp|tar|gz)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Header di sicurezza aggiuntivi per Apache
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS resta gestito da SecurityHeaders (solo in produzione, solo sulle
    # risposte servite da Laravel): non duplicato qui per non allargare la
    # superficie di questa modifica, gia' focalizzata sul redirect https.
</IfModule>
